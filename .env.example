# Copy to .env before running: cp .env.example .env
# .env is gitignored — never commit real values.

# --- Kafka -------------------------------------------------------------------
# From your host (Python services running outside Docker):
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw-commits

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=raw-commits
MINIO_ENDPOINT=http://localhost:9000

# --- PostgreSQL (Neon serverless) --------------------------------------------
# Neon gives you TWO connection strings. Use the right one for the right job:
#
#   POOLED (hostname contains "-pooler")  -> app runtime / stream processor.
#     PgBouncer in transaction mode; good for many short-lived connections.
#
#   DIRECT (hostname WITHOUT "-pooler")   -> schema apply, migrations, psql.
#     Transaction-mode pooling breaks prepared statements and can time out on
#     large transactions, so schema work must use the direct string.
#
# Grab both from the Neon dashboard (Connect button) or the Neon CLI.
POSTGRES_POOLED_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
POSTGRES_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- ClickHouse --------------------------------------------------------------
CLICKHOUSE_USER=commitpulse
CLICKHOUSE_PASSWORD=commitpulse
CLICKHOUSE_DB=commitpulse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# --- Chroma ------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=commits

# --- GitHub (fill these in when you wire up the webhook / backfill) ----------
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# --- LLM (for the AI chat router, later) -------------------------------------
# Provider-neutral vars — swap the provider without code changes.
# Default: OpenCode Zen (OpenAI-compatible gateway).
# List available model IDs: curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models
# Valid example: claude-haiku-4-5 (cheap + fast, good for routing/classification)
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5
